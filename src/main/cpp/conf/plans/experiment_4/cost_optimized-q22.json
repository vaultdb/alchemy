      ],
      "sql" : "WITH all_customers AS (\n    SELECT \n        ck.c_custkey, \n        NOT (COALESCE(substring(c.c_phone from 1 for 2), '') IN ('24', '31', '11', '16', '21', '20', '34')) AS dummy_tag\n    FROM customer_keys ck\n    LEFT JOIN customer c ON ck.c_custkey = c.c_custkey\n),\norder_keys AS (\n    SELECT DISTINCT o_custkey FROM orders\n)\nSELECT  \n    c.c_custkey,  \n    COALESCE(o.o_custkey, 1) AS o_custkey,\n    CASE \n        WHEN c.dummy_tag = FALSE THEN FALSE\n        ELSE TRUE\n    END AS dummy_tag\nFROM all_customers c \nLEFT JOIN order_keys o ON c.c_custkey = o.o_custkey\nORDER BY c.c_custkey"
    },
